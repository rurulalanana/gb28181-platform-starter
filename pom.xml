<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>io.github.rurulalanana</groupId>
  <artifactId>gb28181-platform-starter</artifactId>
  <version>1.0.2</version>
  <name>gb28181-platform-starter</name>
  <description>GB28181 流媒体平台 Starter：Spring Boot 集成 gb28181-sip（信令）+ gb28181-sip-zlm（媒体，内嵌 ZLMediaKit）</description>

  <!--
    随 sdk-dahua 仓库携带的本地 Maven 仓库，用于 com.netsdk:netsdk。

    【为什么本模块也要声明】<repositories> 只沿 parent 继承，不沿聚合传递。
    本模块的 parent 是 spring-boot-starter-parent，拿不到 sdk-dahua 里那份声明。
    而本模块又需要 netsdk 的 class（大华 provider 运行时会调用 com.netsdk.lib.*），
    缺了会在第一次用大华设备时抛 NoClassDefFoundError。

    不声明会怎样：本地仓库里已经有 netsdk 了，但 Maven 通过 _remote.repositories
    记着「这个构件来自 sdk-dahua-bundled」；本模块的仓库列表里没有它，
    于是判定为「不可用」，报
      Cannot access aliyun in offline mode and the artifact
      com.netsdk:netsdk:jar:3.061 has not been downloaded from it before

    路径是相对的（../sdk-dahua），与本项目「四个仓库并列」的布局一致。
    单独 clone 本仓库本来就无法构建（还依赖 sip / sip-zlm / sdk-dahua），
    因此不引入新的限制。
  -->
  <repositories>
    <repository>
      <id>sdk-dahua-bundled</id>
      <name>sdk-dahua 随仓库携带的本地构件</name>
      <url>file:///${project.basedir}/../sdk-dahua/lib/netsdk-repo</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <sip.module.version>1.0.14</sip.module.version>
    <zlm.module.version>1.0.10</zlm.module.version>
    <!-- 大华设备接入（厂商无关契约 + NetSDK 实现）。
         命名约定 sdk-<厂商>：将来接海康/宇视就是平级的 sdk-hikvision / sdk-uniview。 -->
    <sdk-dahua.module.version>1.0.0</sdk-dahua.module.version>
    <!-- 大华 NetSDK 的 Java 部分，需先 install 到本地仓库（不在中央仓库）。
         版本必须与 sdk-dahua 里的一致，否则运行时会缺类。 -->
    <netsdk.version>3.061</netsdk.version>
    <mybatis-plus.version>3.5.11</mybatis-plus.version>
    <aws.sdk.version>2.28.11</aws.sdk.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- GB28181 信令模块。
         注意：jain-sip 1.2.344 硬依赖 log4j 1.x 的 API（org.apache.log4j.Priority / Layout），
         log4j-over-slf4j 不提供 Layout，缺失会直接抛 PeerUnavailableException，
         因此这里不能排除 log4j；其日志输出由 log4j.properties 单独收敛（应用日志仍走 Logback）。 -->
    <dependency>
      <groupId>io.github.rurulalanana</groupId>
      <artifactId>gb28181-sip</artifactId>
      <version>${sip.module.version}</version>
    </dependency>

    <!-- 大华接入：契约（deviceaccess 包）+ 厂商实现（dahua 包）。
         平台只用其中的 deviceaccess 包（接口），不直接引用 dahua 包的类；
         netsdk / jna 在该模块里是 provided，不会传递到这里 ——
         因此没装 SDK 的机器也能正常编译与运行国标链路。 -->
    <dependency>
      <groupId>io.github.rurulalanana</groupId>
      <artifactId>sdk-dahua</artifactId>
      <version>${sdk-dahua.module.version}</version>
    </dependency>

    <!--
      大华 NetSDK 的 Java 部分（class 文件）。

      为什么必须在这里显式声明：sdk-dahua 模块里 netsdk 是 provided，
      不传递；但大华 provider 在运行时会直接调用 com.netsdk.lib.*，
      缺了会在第一次用大华设备时抛 NoClassDefFoundError。

      用 compile 而不是 provided：本平台交付形态是单 jar 部署
      （前端产物都打进 jar 了），运维不应再手工摆 classpath。

      **原生库不在这里** —— 它们由 sdk-dahua 的 jar 按 profile 携带
      （linux64/*.so 或 win64/*.dll），见 sdk-dahua/docs/原生库打包.md。
      本依赖只提供 4.7 MB 的 class，不含任何 .so/.dll。

      获取方式（不在中央仓库）：见 docs/大华SDK接入.md §8。
      未安装时构建会失败 —— 需要大华功能就必须先装；
      不需要时把本依赖与 sdk-dahua 依赖一起注释掉即可。
    -->
    <dependency>
      <groupId>com.netsdk</groupId>
      <artifactId>netsdk</artifactId>
      <version>${netsdk.version}</version>
    </dependency>

    <!-- 流媒体服务模块（内嵌 ZLMediaKit，自带各平台原生库） -->
    <dependency>
      <groupId>io.github.rurulalanana</groupId>
      <artifactId>gb28181-sip-zlm</artifactId>
      <version>${zlm.module.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- PostgreSQL -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.3</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- MyBatis-Plus（Spring Boot 3 专用 starter） -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- 3.5.9+ 起分页/防全表更新等插件被拆到 jsqlparser 模块，需显式引入 -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-jsqlparser</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- Sa-Token 鉴权 -->
    <dependency>
      <groupId>cn.dev33</groupId>
      <artifactId>sa-token-spring-boot3-starter</artifactId>
      <version>1.44.0</version>
    </dependency>

    <!-- 密码校验（BCrypt） -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- 对象存储（S3 兼容协议）：一套 SDK 覆盖阿里云 OSS / 腾讯云 COS / MinIO /
         七牛云 Kodo / AWS S3 / Ceph RGW 等主流对象存储。
         仅引入 s3 与 apache-client（同步 HTTP 客户端），不引入整个 AWS SDK。 -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${aws.sdk.version}</version>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <classpathScope>test</classpathScope>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.github.rurulalanana.starter.Gb28181PlatformApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>